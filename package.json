{
  "name": "rpg-cljs",
  "private": true,
  "devDependencies": {
    "playwright": "1.65.1",
    "shadow-cljs": "^2.28.15"
  },
  "scripts": {
    "watch": "shadow-cljs watch app",
    "repl": "shadow-cljs cljs-repl app",
    "build": "shadow-cljs release app",
    "test:node": "shadow-cljs run shadow.cljs.build-report app build-report.html && shadow-cljs compile node-test && node out/node-test.js",
    "test:ci": "shadow-cljs compile node-test && node out/node-test.js",
    "test:browser:watch": "shadow-cljs watch browser-test",
    "test:browser:once": "shadow-cljs compile browser-test"
  }
}
